# =============================================================================
# SOC-Scale SIEM Pipeline — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git — it's in .gitignore.
# =============================================================================

# ── Redis (your existing container) ──────────────────────────────────────────
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTIC_PASSWORD=CHANGE_ME_elastic_password
ES_USER=elastic
ES_PORT=9200
ES_VERSION=8.17.0

# ── Logstash ─────────────────────────────────────────────────────────────────
LS_VERSION=8.17.0

# ── Kibana ───────────────────────────────────────────────────────────────────
KIBANA_VERSION=8.17.0
KIBANA_PORT=5601
